#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "my_defines.dtsi"

/ {
    /* ========================================
     * カスタムビヘイビア定義
     * ======================================== */
    behaviors {
        /* モッドタップ: 長押しで修飾キー、タップで通常キー */
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
    
    /* ========================================
     * キーコンボ定義（同時押しで別のキーを発火）
     * ======================================== */
    combos {
        compatible = "zmk,combos";
        
        /* 13 + 16 同時押し → 半角（英数） */
        eisu {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&kp J_EISU>;
        };

        /* 12 + 17 同時押し → 全角（かな） */
        kana2 {
            timeout-ms = <50>;
            key-positions = <12 17>;
            bindings = <&kp J_KANA>;
        };

        /* 11 + 18 同時押し → 半角/全角切り替え */
        hanzen {
            timeout-ms = <50>;
            key-positions = <11 18>;
            bindings = <&kp J_HANZEN>;
        };

        /* 13 + 14 同時押し → _ (アンダースコア) */
        underscore_left {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp J_UNDER>;
        };

        /* 15 + 16 同時押し → - (ハイフン) */
        hyphen_right {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp MINUS>;
        };

        /* 23 + 24 同時押し → ? (クエスチョン) */
        question_left {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp QMARK>;
        };

        /* 3 + 4 同時押し → ! (エクスクラメーション) */
        exclamation_left {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp EXCL>;
        };

        /* 5 + 6 同時押し → @ (アットマーク) */
        at_right {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&kp J_AT>;
        };

        /* 21 + 22 同時押し → マウスボタン4（進む） */
        mouse_forward_left {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&mkp MB5>;
        };

        /* 3 + 13 同時押し → 左クリック */
        left_click_alt_left {
            timeout-ms = <50>;
            key-positions = <3 13>;
            bindings = <&mkp LCLK>;
        };

        /* 6 + 16 同時押し → 左クリック */
        left_click_alt_right {
            timeout-ms = <50>;
            key-positions = <6 16>;
            bindings = <&mkp LCLK>;
        };

        /* 2 + 12 同時押し → 右クリック */
        right_click_alt_left {
            timeout-ms = <50>;
            key-positions = <2 12>;
            bindings = <&mkp RCLK>;
        };

        /* 7 + 17 同時押し → 右クリック */
        right_click_alt_right {
            timeout-ms = <50>;
            key-positions = <7 17>;
            bindings = <&mkp RCLK>;
        };

        /* 1 + 11 同時押し → 中クリック */
        middle_click_alt_left {
            timeout-ms = <50>;
            key-positions = <1 11>;
            bindings = <&mkp MCLK>;
        };

        /* 8 + 18 同時押し → 中クリック */
        middle_click_alt_right {
            timeout-ms = <50>;
            key-positions = <8 18>;
            bindings = <&mkp MCLK>;
        };

        /* 13 + 23 同時押し → 戻るボタン */
        back_alt_left {
            timeout-ms = <50>;
            key-positions = <13 23>;
            bindings = <&mkp MB4>;
        };

        /* 16 + 26 同時押し → 戻るボタン */
        back_alt_right {
            timeout-ms = <50>;
            key-positions = <16 26>;
            bindings = <&mkp MB4>;
        };

        /* 12 + 22 同時押し → 進むボタン */
        forward_alt_left {
            timeout-ms = <50>;
            key-positions = <12 22>;
            bindings = <&mkp MB5>;
        };

        /* 17 + 27 同時押し → 進むボタン */
        forward_alt_right {
            timeout-ms = <50>;
            key-positions = <17 27>;
            bindings = <&mkp MB5>;
        };

        /* 11 + 21 同時押し → スクリーンショット */
        screenshot_left {
            timeout-ms = <50>;
            key-positions = <11 21>;
            bindings = <&snp_tl>;
        };

        /* 18 + 28 同時押し → スクリーンショット */
        screenshot_right {
            timeout-ms = <50>;
            key-positions = <18 28>;
            bindings = <&snp_tl>;
        };

        /* 8 + 9 同時押し → Layer5 (Setting)トグル */
        setting_mode {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&tog LAY_SETTING>;
        };

        /* 0 + 1 同時押し → Layer 1（GAME_MODE、旧layer7）トグル
         * ※旧ONIK_LAYOUT用コンボを転用。layer1の中身をGAME_MODEに差し替えたため、
         *   このコンボの役割もGAME_MODEのトグルに変更した。
         */
        toggle_game_mode {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&tog LAY_GAME>;
        };

        /* 16 + 17 同時押し（NUMBER+FUNCTIONレイヤー中のみ） → + */
        numfunc_plus {
            timeout-ms = <50>;
            key-positions = <16 17>;
            layers = <LAY_NUMFUNC>;
            bindings = <&kp KP_PLUS>;
        };

        /* 17 + 18 同時押し（NUMBER+FUNCTIONレイヤー中のみ） → - */
        numfunc_minus {
            timeout-ms = <50>;
            key-positions = <17 18>;
            layers = <LAY_NUMFUNC>;
            bindings = <&kp KP_MINUS>;
        };

        /* 26 + 27 同時押し（NUMBER+FUNCTIONレイヤー中のみ） → * */
        numfunc_multiply {
            timeout-ms = <50>;
            key-positions = <26 27>;
            layers = <LAY_NUMFUNC>;
            bindings = <&kp KP_MULTIPLY>;
        };

        /* 27 + 28 同時押し（NUMBER+FUNCTIONレイヤー中のみ） → / */
        numfunc_divide {
            timeout-ms = <50>;
            key-positions = <27 28>;
            layers = <LAY_NUMFUNC>;
            bindings = <&kp KP_DIVIDE>;
        };

    };

    /* ========================================
     * マクロ定義
     * ======================================== */
    macros {
        /* Windowsスクリーンショット（Win + Shift + S） */
        snp_tl: snp_tl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHIFT>
                     , <&macro_tap &kp S>
                     , <&macro_release &kp LGUI &kp LSHIFT>;
        };
        
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings =  <
&lt LAY_SWAP_SLOW_TB Q  &kp W              &kp E          &kp R             &kp T           &kp Y          &kp U             &kp I          &kp O              &lt LAY_SWAP_SLOW_TB P
&lt LAY_SWAP_TB A       &lt LAY_NUMFUNC S  &lt LAY_NAV D  &lt LAY_SYMBOL F  &kp G           &kp H          &lt LAY_SYMBOL J  &lt LAY_NAV K  &lt LAY_NUMFUNC L  &lt LAY_SWAP_TB SEMI
&lt LAY_SLOW_TB Z       &kp X              &kp C          &lt LAY_NAV V     &kp B           &kp N          &kp M             &kp COMMA      &kp DOT            &lt LAY_SLOW_TB SLASH
&mkp LCLK               &kp LGUI           &mt LCTRL RET  &mt LSHFT SPC     &mt LALT BSPC   &mt RALT BSPC  &mt RSHFT SPC     &mt RCTRL RET  &kp RGUI           &mkp LCLK
            >;
        };

        layer1 {
            label = "GAME_MODE";
            bindings = <
&kp Q                   &kp W              &kp E          &kp R             &kp T           &kp Y          &kp U             &kp I          &kp O              &kp P
&kp A                   &kp S              &kp D          &kp F             &kp G           &kp H          &kp J             &kp K          &kp L              &kp SEMI
&kp Z                   &kp X              &kp C          &kp V             &kp B           &kp N          &kp M             &kp COMMA      &kp DOT            &kp BACKSLASH
&trans                  &trans             &trans         &trans            &trans          &trans         &trans            &trans         &trans             &trans
            >;
        };

        layer2 {
            label = "SYMBOL";
            bindings = <
&kp EXCL                &kp J_DQT          &kp HASH       &kp DLLR          &kp PRCNT       &kp J_AMPS     &kp J_SQT         &kp J_LPAR     &kp J_RPAR         &kp J_EQUAL
&kp LSHFT               &kp J_PIPE         &kp J_TILDE    &kp J_UNDER       &kp QMARK       &kp J_AT       &kp MINUS         &kp J_LBRC     &kp J_RBRC         &kp J_COLON
&kp LALT                &kp J_CARET        &kp J_GRAVE    &kp J_PLUS        &kp J_ASTRK     &kp LT         &kp GT            &kp J_LBKT     &kp J_RBKT         &kp J_YEN
&mkp RCLK               &none              &mt LCTRL ESC  &mt LSHFT TAB     &mt LALT DEL    &mt RALT DEL   &mt RSHFT TAB     &mt RCTRL ESC  &none              &mkp RCLK
            >;
        };

        layer3 {
            label = "NAVIGATION";
            bindings = <
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
&none                   &none              &none          &kp LC(LA(TAB))   &none           &kp LEFT       &kp DOWN          &kp UP         &kp RIGHT          &kp RSHFT
&none                   &none              &none          &kp LG(TAB)       &none           &kp HOME       &kp END           &kp PG_UP      &kp PG_DN          &kp RALT
&mkp MB4                &none              &trans         &trans            &trans          &trans         &trans            &trans         &none              &mkp MB4
            >;
        };

        layer4 {
            label = "NUMBER+FUNCTION";
            bindings = <
&kp F1                  &kp F2             &kp F3         &kp F4            &kp F5          &kp EQUAL      &kp N7            &kp N8         &kp N9             &none
&kp F6                  &kp F7             &kp F8         &kp F9            &kp F10         &kp KP_DOT     &kp N4            &kp N5         &kp N6             &none
&none                   &none              &none          &kp F11           &kp F12         &kp N0         &kp N1            &kp N2         &kp N3             &none
&mkp MB5                &none              &trans         &trans            &trans          &trans         &trans            &trans         &kp KP_NUM         &mkp MB5
            >;
        };

        layer5 {
            label = "Setting";
            bindings = <
&bt BT_SEL 0            &bt BT_SEL 1       &bt BT_SEL 2   &bt BT_SEL 3      &bt BT_SEL 4    &none          &none             &none          &none              &none
&none                   &none              &none          &none             &bt BT_CLR      &none          &none             &none          &none              &none
&none                   &none              &none          &none             &bt BT_CLR_ALL  &none          &none             &none          &none              &none
&none                   &none              &trans         &trans            &trans          &trans         &trans            &trans         &none              &none
            >;
        };

        layer6 {
            label = "SCROLL_R";
            bindings = <
&trans                  &trans             &trans         &trans            &trans          &trans         &kp CWL           &kp CWR        &trans             &trans
&trans                  &trans             &trans         &trans            &trans          &trans         &mkp MB4          &mkp MB5       &trans             &trans
&trans                  &trans             &trans         &trans            &trans          &trans         &trans            &trans         &trans             &trans
&trans                  &trans             &trans         &trans            &trans          &trans         &trans            &trans         &trans             &trans
            >;
        };

        layer7 {
            label = "SWAP_TB";
            bindings = <
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
&none                   &kp LEFT           &kp UP         &kp DOWN          &kp RIGHT       &kp LEFT       &kp DOWN          &kp UP         &kp RIGHT          &none
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
            >;
        };

        layer8 {
            label = "SLOW_TB";
            bindings = <
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
&none                   &kp LEFT           &kp UP         &kp DOWN          &kp RIGHT       &kp LEFT       &kp DOWN          &kp UP         &kp RIGHT          &none
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
            >;
        };

        layer9 {
            label = "SWAP_SLOW_TB";
            bindings = <
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
&none                   &kp LEFT           &kp UP         &kp DOWN          &kp RIGHT       &kp LEFT       &kp DOWN          &kp UP         &kp RIGHT          &none
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
&none                   &none              &none          &none             &none           &none          &none             &none          &none              &none
            >;
        };
    };
};
